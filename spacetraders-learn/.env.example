# Get an account at https://my.spacetraders.io then create/register an agent.
# Paste the agent token here (Bearer token used for gameplay + private data).
SPACETRADERS_TOKEN=

# Optional: used only by `stlearn register` (account token from the dashboard).
SPACETRADERS_ACCOUNT_TOKEN=

# Agent callsign + starting faction when registering a new agent.
SPACETRADERS_SYMBOL=LEARNER
SPACETRADERS_FACTION=COSMIC

# Paths (relative to this project by default)
STLEARN_DATA_DIR=data
STLEARN_DB_PATH=data/warehouse/spacetraders.db